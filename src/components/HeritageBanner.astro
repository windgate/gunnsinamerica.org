---
// Scrolling band of family artifacts, ordered by the numeric prefix of each
// filename (earliest generations first). Pure CSS animation, self-hosted
// images, no runtime dependencies. Edit/reorder public/images/banner/banner.json.
import items from '../../public/images/banner/banner.json';
const base = '/images/banner/';
---
<section class="heritage-banner" aria-label="Family artifacts, 1635 to the present">
  <button type="button" class="hb-toggle" aria-pressed="false" aria-label="Pause scrolling images">
    <span class="hb-icon" aria-hidden="true">❚❚</span>
  </button>

  <div class="hb-viewport">
    <ul class="hb-track">
      {items.map((it, i) => (
        <li class="hb-item">
          <img src={base + it.file} alt="" width={it.width} height={it.height}
               loading={i < 6 ? 'eager' : 'lazy'} decoding="async" />
        </li>
      ))}
      {items.map((it) => (
        <li class="hb-item hb-dup" aria-hidden="true">
          <img src={base + it.file} alt="" width={it.width} height={it.height}
               loading="lazy" decoding="async" />
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Optional pause control (the banner works without JS).
  const root = document.querySelector('.heritage-banner');
  const btn = root?.querySelector('.hb-toggle');
  btn?.addEventListener('click', () => {
    const paused = root!.classList.toggle('is-paused');
    btn.setAttribute('aria-pressed', String(paused));
    btn.setAttribute('aria-label', paused ? 'Resume scrolling images' : 'Pause scrolling images');
    const icon = btn.querySelector('.hb-icon');
    if (icon) icon.textContent = paused ? '▶' : '❚❚';
  });
</script>

<style>
  .heritage-banner {
    --hb-h: clamp(84px, 11vw, 120px);
    position: relative;
    background: var(--ink);
    border-bottom: 3px solid var(--gold);
    padding: 0.5rem 0;
  }
  .hb-viewport { overflow: hidden; height: var(--hb-h); }
  .hb-track {
    display: flex;
    width: max-content;
    height: 100%;
    margin: 0; padding: 0; list-style: none;
    animation: hb-scroll 150s linear infinite;
  }
  .hb-item {
    flex: none;
    height: 100%;
    margin-right: 0.5rem;
    background: var(--paper-dark);
    border: 1px solid var(--gold);
  }
  .hb-item img { display: block; height: 100%; width: auto; filter: sepia(0.15); }

  .heritage-banner:hover .hb-track,
  .heritage-banner.is-paused .hb-track { animation-play-state: paused; }

  .hb-toggle {
    position: absolute; z-index: 2; right: 0.75rem; bottom: 0.9rem;
    min-width: 2rem; height: 2rem; padding: 0 0.5rem;
    font-size: 0.7rem; line-height: 1;
    color: var(--paper); background: rgba(28, 24, 20, 0.85);
    border: 1px solid var(--gold); border-radius: 3px; cursor: pointer;
  }
  .hb-toggle:hover { color: var(--gold); }
  .hb-toggle:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }

  @keyframes hb-scroll { to { transform: translateX(-50%); } }

  /* Reduced motion: static, swipeable strip; no duplicate set, no pause button */
  @media (prefers-reduced-motion: reduce) {
    .hb-viewport { overflow-x: auto; }
    .hb-track { animation: none; }
    .hb-dup, .hb-toggle { display: none; }
  }
</style>
