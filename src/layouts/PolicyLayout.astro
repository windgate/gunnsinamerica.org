---
// src/layouts/PolicyLayout.astro
// Shared shell for the site-policy pages (Privacy, Terms, Accessibility).
import BaseLayout from './BaseLayout.astro';
import { POLICY_PAGES } from '../data/site-policies';

export interface Props {
  title:       string;
  description: string;
  lead:        string;
  dateLabel:   string;   // e.g. "Effective" or "Last reviewed"
  date:        string;
}

const { title, description, lead, dateLabel, date } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const others = POLICY_PAGES.filter(p => p.href !== path);
---

<BaseLayout title={title} description={description}>
  <article class="policy-page">

    <header class="policy-header">
      <p class="eyebrow">Site Policies</p>
      <h1>{title}</h1>
      <p class="policy-date">{dateLabel} {date}</p>
      <p class="lead">{lead}</p>
    </header>

    <div class="policy-body">
      <slot />
    </div>

    <nav class="policy-related" aria-label="Other site policies">
      <span class="policy-related-label">Also see</span>
      {others.map(p => <a href={p.href}>{p.label}</a>)}
    </nav>

  </article>
</BaseLayout>

<style>
  .policy-page {
    max-width: var(--max);
    margin:    0 auto;
    padding:   clamp(2rem, 5vw, 4rem) 2rem;
  }

  .policy-header {
    border-bottom:  1px solid var(--rule);
    padding-bottom: 2.5rem;
    margin-bottom:  3rem;
  }
  .eyebrow {
    font-family:    var(--sans);
    font-size:      0.68rem;
    font-weight:    600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color:          var(--accent);
    margin-bottom:  0.5rem;
  }
  .policy-header h1 {
    font-family:   var(--serif);
    font-size:     clamp(2rem, 5vw, 3rem);
    font-weight:   700;
    line-height:   1.15;
    margin-bottom: 0.75rem;
  }
  .policy-date {
    font-family:    var(--sans);
    font-size:      0.75rem;
    font-weight:    500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color:          var(--ink-light);
    margin-bottom:  1.25rem;
  }
  .lead {
    font-size:   1.05rem;
    color:       var(--ink-light);
    line-height: 1.8;
    max-width:   600px;
  }

  .policy-body {
    display:        flex;
    flex-direction: column;
    gap:            2.75rem;
  }
  .policy-body :global(section h2) {
    font-family:    var(--serif);
    font-size:      1.4rem;
    font-weight:    700;
    color:          var(--ink);
    margin-bottom:  1rem;
    padding-bottom: 0.5rem;
    border-bottom:  1px solid var(--rule);
  }
  .policy-body :global(section h3) {
    font-family:   var(--sans);
    font-size:     0.85rem;
    font-weight:   600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color:         var(--ink);
    margin:        1.5rem 0 0.5rem;
  }
  .policy-body :global(p),
  .policy-body :global(li) {
    font-size:   1rem;
    line-height: 1.8;
    color:       var(--ink-light);
  }
  .policy-body :global(p) { margin-bottom: 1rem; }
  .policy-body :global(p:last-child) { margin-bottom: 0; }
  .policy-body :global(strong) { color: var(--ink); }
  .policy-body :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
  .policy-body :global(a:hover) { color: var(--ink); }

  .policy-body :global(ul) {
    list-style:     none;
    padding:        0;
    margin-bottom:  1rem;
    display:        flex;
    flex-direction: column;
    gap:            0.75rem;
  }
  .policy-body :global(ul li) {
    padding-left: 1.25rem;
    border-left:  2px solid var(--rule);
  }

  .policy-body :global(.policy-callout) {
    background:  var(--white);
    border:      1px solid var(--rule);
    border-top:  3px solid var(--gold);
    padding:     1.5rem 2rem;
  }

  .policy-related {
    margin-top:  3.5rem;
    padding:     1.5rem 0 0;
    border-top:  1px solid var(--rule);
    display:     flex;
    flex-wrap:   wrap;
    gap:         0.5rem 1.5rem;
    align-items: baseline;
    /* reset global nav styles */
    position:    static;
    height:      auto;
    background:  none;
    border-bottom: none;
    justify-content: flex-start;
  }
  .policy-related-label {
    font-family:    var(--sans);
    font-size:      0.68rem;
    font-weight:    600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color:          var(--ink-light);
  }
  .policy-related a {
    font-family:    var(--sans);
    font-size:      0.8rem;
    font-weight:    600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color:          var(--accent);
  }
</style>
