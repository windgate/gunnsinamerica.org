---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('journal'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function fmtDate(d: Date) {
  return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
---

<BaseLayout title="Research Journal" description="Research notes, discoveries, and dead ends — the working record of Gunn family history in progress.">

  <div class="journal-page">

    <header class="page-header">
      <p class="eyebrow">Gunn Family Research</p>
      <h1>Journal</h1>
      <p class="page-desc">
        Research notes, discoveries, and narrative threads — recorded as the history unfolds.
      </p>
    </header>

    <div class="entries">
      {entries.length > 0 ? (
        entries.map(async entry => {
          const { Content } = await entry.render();
          return (
            <article class="entry">
              <div class="entry-date">
                <span class="date-rule" aria-hidden="true" />
                <span class="date-year">{entry.data.historicalYear}</span>
                <span class="date-month">{fmtDate(entry.data.date)}</span>
              </div>
              <div class="entry-body">
                {entry.data.tag && <span class="entry-tag">{entry.data.tag}</span>}
                <h2>{entry.data.title}</h2>
                <div class="entry-prose"><Content /></div>
                {entry.data.link && (
                  <a class="entry-link" href={entry.data.link.url}>{entry.data.link.text} →</a>
                )}
              </div>
            </article>
          );
        })
      ) : (
        <article class="entry">
          <div class="entry-date">
            <span class="date-rule" aria-hidden="true" />
            <span class="date-year">1635</span>
            <span class="date-month">Jun 2026</span>
          </div>
          <div class="entry-body">
            <span class="entry-tag">Arrival</span>
            <h2>Jasper Gunn Steps Ashore at Boston</h2>
            <div class="entry-prose">
              <p>
                The <em>Defence of London</em>, master Edward Bostock, sailed from London on
                14 July 1635 and arrived at Boston harbor on 8 October. The Custom House
                clerk recorded them as <em>Jasper Gonn</em>, aged 29, and <em>Ann Gonn</em>,
                aged 25. The misspelling is the original document's own hand.
              </p>
            </div>
            <a class="entry-link" href="/articles/jasper-gunn-arrives">Read the full article →</a>
          </div>
        </article>
      )}
    </div>

  </div>

</BaseLayout>

<style>
  .journal-page {
    max-width: var(--max);
    margin:    0 auto;
    padding:   clamp(2rem, 5vw, 4rem) 2rem;
  }

  .page-header {
    border-bottom:  1px solid var(--rule);
    padding-bottom: 2rem;
    margin-bottom:  3rem;
  }
  .eyebrow {
    font-family:    var(--sans);
    font-size:      0.68rem;
    font-weight:    600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color:          var(--gold);
    margin-bottom:  0.4rem;
  }
  .page-header h1 {
    font-family:   var(--serif);
    font-size:     clamp(2rem, 5vw, 3rem);
    font-weight:   700;
    margin-bottom: 0.5rem;
  }
  .page-desc {
    font-size:   1rem;
    color:       var(--ink-light);
    line-height: 1.7;
  }

  .entries { display: flex; flex-direction: column; }

  .entry {
    display:       grid;
    grid-template-columns: 110px 1fr;
    gap:           0 2.5rem;
    padding-bottom: 3rem;
    margin-bottom:  3rem;
    border-bottom:  1px solid var(--rule);
  }
  .entry:last-child { border-bottom: none; margin-bottom: 0; }

  /* Date column */
  .entry-date  { padding-top: 3px; }
  .date-rule   {
    display:       block;
    width:         28px;
    height:        3px;
    background:    var(--gold);
    margin-bottom: 8px;
  }
  .date-year {
    display:     block;
    font-family: var(--serif);
    font-size:   1.4rem;
    font-weight: 700;
    line-height: 1;
    color:       var(--ink);
  }
  .date-month {
    display:        block;
    font-family:    var(--sans);
    font-size:      0.68rem;
    font-weight:    500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color:          var(--ink-light);
    margin-top:     5px;
  }

  /* Entry body */
  .entry-tag {
    display:        inline-block;
    font-family:    var(--sans);
    font-size:      0.6rem;
    font-weight:    600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color:          var(--accent2);
    border:         1px solid var(--accent2);
    padding:        2px 8px;
    margin-bottom:  0.6rem;
  }
  .entry-body h2 {
    font-family:   var(--serif);
    font-size:     1.25rem;
    font-weight:   700;
    line-height:   1.3;
    margin-bottom: 0.75rem;
    color:         var(--ink);
  }
  .entry-prose {
    font-size:   0.95rem;
    line-height: 1.78;
    color:       var(--ink-light);
  }
  .entry-prose :global(p)  { margin-bottom: 0.9rem; }
  .entry-prose :global(em) { font-style: italic; color: var(--ink); }

  .entry-link {
    display:        inline-block;
    margin-top:     0.9rem;
    font-family:    var(--sans);
    font-size:      0.7rem;
    font-weight:    600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color:          var(--accent);
    text-decoration: none;
    border-bottom:  1px solid transparent;
    transition:     border-color 0.15s;
  }
  .entry-link:hover { border-color: var(--accent); text-decoration: none; }

  @media (max-width: 500px) {
    .entry { grid-template-columns: 1fr; gap: 0.75rem; }
    .date-rule { display: none; }
    .entry-date { display: flex; align-items: center; gap: 1rem; }
    .date-year  { font-size: 1rem; }
  }
</style>
