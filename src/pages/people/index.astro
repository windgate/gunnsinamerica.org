---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const people = (await getCollection('people'))
  .sort((a, b) =>
    (a.data.order ?? 999) - (b.data.order ?? 999) ||
    a.data.title.localeCompare(b.data.title)
  );

const eras = ['All', 'Colonial', 'Revolutionary', 'War of 1812', 'Frontier', 'Civil War', 'Modern'];
---

<BaseLayout title="People" description="The individuals of the Gunn family, from the first immigrant generation onward.">

  <div class="people-page">

    <header class="page-header">
      <p class="eyebrow">Gunn Family History</p>
      <h1>People</h1>
      <p class="page-desc">
        The men and women of the Gunn family, from Jasper's arrival in 1635
        through the generations that followed.
      </p>
    </header>

    <div class="filter-bar" role="group" aria-label="Filter by era">
      {eras.map(era => (
        <button class:list={['filter-btn', { active: era === 'All' }]} data-era={era}>
          {era}
        </button>
      ))}
    </div>

    <div class="people-list">
      {people.length > 0 ? people.map(p => (
        <a href={`/people/${p.slug}`} class="person-row" data-era={p.data.era ?? ''}>
          <div class="row-meta">
            {p.data.birth && <span class="row-year">{p.data.birth}</span>}
            {p.data.era   && <span class="row-era">{p.data.era}</span>}
          </div>
          <div class="row-body">
            <h2>{p.data.title}</h2>
            {p.data.epithet && <p>{p.data.epithet}</p>}
          </div>
          <span class="row-arrow" aria-hidden="true">→</span>
        </a>
      )) : (
        <p class="empty">
          Biographies are being prepared. Follow along in the <a href="/journal">Research Journal</a>.
        </p>
      )}
    </div>

  </div>

</BaseLayout>

<style>
  .people-page {
    max-width: var(--max-wide);
    margin:    0 auto;
    padding:   clamp(2rem, 5vw, 4rem) 2rem;
  }

  .page-header {
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2rem;
    margin-bottom:  2rem;
  }
  .eyebrow {
    font-family:    var(--sans);
    font-size:      0.68rem;
    font-weight:    600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color:          var(--gold);
    margin-bottom:  0.4rem;
  }
  .page-header h1 {
    font-family:   var(--serif);
    font-size:     clamp(2rem, 5vw, 3rem);
    font-weight:   700;
    margin-bottom: 0.5rem;
  }
  .page-desc {
    font-size:   1rem;
    color:       var(--ink-light);
    max-width:   520px;
    line-height: 1.7;
  }

  .filter-bar {
    display:       flex;
    flex-wrap:     wrap;
    gap:           0.5rem;
    margin-bottom: 2.5rem;
  }
  .filter-btn {
    font-family:    var(--sans);
    font-size:      0.68rem;
    font-weight:    600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding:        0.4rem 1rem;
    border:         1px solid var(--rule);
    background:     transparent;
    color:          var(--ink-light);
    cursor:         pointer;
    transition:     all 0.15s;
  }
  .filter-btn:hover { border-color: var(--accent); color: var(--ink); }
  .filter-btn.active { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  .people-list { display: flex; flex-direction: column; }

  .person-row {
    display:         grid;
    grid-template-columns: 140px 1fr 2rem;
    gap:             1.5rem;
    align-items:     start;
    padding:         1.75rem 0;
    border-bottom:   1px solid var(--rule);
    text-decoration: none;
    color:           var(--ink);
    transition:      background 0.12s;
  }
  .person-row:hover { background: var(--paper-dark); margin: 0 -1rem; padding-left: 1rem; padding-right: 1rem; text-decoration: none; }
  .person-row[hidden] { display: none; }

  .row-meta { display: flex; flex-direction: column; gap: 4px; padding-top: 3px; }
  .row-year {
    font-family: var(--serif);
    font-size:   1.1rem;
    font-weight: 700;
  }
  .row-era {
    font-family:    var(--sans);
    font-size:      0.62rem;
    font-weight:    600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color:          var(--accent);
  }

  .row-body h2 {
    font-family:   var(--serif);
    font-size:     1.15rem;
    font-weight:   700;
    line-height:   1.3;
    margin-bottom: 0.4rem;
  }
  .row-body p {
    font-size:   0.9rem;
    color:       var(--ink-light);
    line-height: 1.65;
  }

  .row-arrow { color: var(--rule); font-size: 1rem; padding-top: 4px; transition: color 0.15s; }
  .person-row:hover .row-arrow { color: var(--accent); }

  .empty { padding: 3rem 0; color: var(--ink-light); font-style: italic; }
  .empty a { color: var(--accent); }

  @media (max-width: 560px) {
    .person-row { grid-template-columns: 1fr; gap: 0.5rem; }
    .row-arrow  { display: none; }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const rows    = document.querySelectorAll<HTMLAnchorElement>('.person-row');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const era = btn.dataset.era;
      rows.forEach(row => {
        row.toggleAttribute('hidden', era !== 'All' && row.dataset.era !== era);
      });
    });
  });
</script>