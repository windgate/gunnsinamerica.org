---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const people = await getCollection('people');
  return people.map(person => ({
    params: { slug: person.slug },
    props:  { person },
  }));
}

const { person } = Astro.props;
const { Content } = await person.render();
const d = person.data;

const resolve = async (slugs: string[] | undefined) =>
  slugs
    ? (await Promise.all(
        slugs
          .filter(s => typeof s === 'string' && s.trim() !== '')
          .map(s => getEntry('people', s).catch(() => null))
      )).filter(Boolean)
    : [];
const parents  = await resolve(d.parents);
const spouse   = await resolve(d.spouse);
const children = await resolve(d.children);
const hasFamily = parents.length + spouse.length + children.length > 0;

// Build TOC server-side from ## headings in raw markdown
const rawBody = person.body ?? '';
const headingMatches = [...rawBody.matchAll(/^## (.+)$/gm)];
const tocItems = headingMatches.map((m, i) => ({
  text: m[1].trim(),
  id:   'section-' + (i + 1),
}));
const showToc = tocItems.length >= 4;
---

<BaseLayout title={d.title} description={d.epithet ?? [d.birth, d.death].filter(Boolean).join(' – ')}>

  <div class="person-page">

    <!-- Breadcrumb -->
    <div class="breadcrumb">
      <a href="/">Home</a>
      <span class="sep">›</span>
      <a href="/people">People</a>
      <span class="sep">›</span>
      <span>{d.title}</span>
    </div>

    <!-- Person header — full width -->
    <header class="person-header">
      {d.era && <div class="person-era">{d.eraLabel ?? d.era}</div>}
      <h1>{d.title}</h1>
      {d.epithet && <p class="person-epithet">{d.epithet}</p>}
      <div class="person-meta">
        {d.birth      && <div class="meta-item"><strong>Born</strong>{d.birth}</div>}
        {d.death      && <div class="meta-item"><strong>Died</strong>{d.death}</div>}
        {d.birthplace && <div class="meta-item"><strong>Birthplace</strong>{d.birthplace}</div>}
        {d.deathplace && <div class="meta-item"><strong>Deathplace</strong>{d.deathplace}</div>}
      </div>
    </header>

    <!-- Portrait / lead image (optional) — full width -->
    {d.leadImage && (
      <figure class="lead-image">
        <img src={d.leadImage} alt={d.leadImageAlt ?? d.title} />
        {d.leadImageCaption && <figcaption>{d.leadImageCaption}</figcaption>}
      </figure>
    )}

    <!-- Two-column layout: body left, TOC right -->
    <div class:list={['content-columns', { 'has-toc': showToc }]}>

      <!-- Article body (left column) -->
      <div class="person-body">

        {hasFamily && (
          <div class="family-callout">
            <h4>Family</h4>
            <ul class="family-list">
              {parents.map(p  => (
                <li><strong>Parent</strong><a href={`/people/${p.slug}`}>{p.data.title}</a></li>
              ))}
              {spouse.map(p   => (
                <li><strong>Spouse</strong><a href={`/people/${p.slug}`}>{p.data.title}</a></li>
              ))}
              {children.map(p => (
                <li><strong>Child</strong><a href={`/people/${p.slug}`}>{p.data.title}</a></li>
              ))}
            </ul>
          </div>
        )}

        <Content />

        {d.sources && d.sources.length > 0 && (
          <div class="sources">
            <h4>Sources &amp; Notes</h4>
            <ol>
              {d.sources.map(s => <li set:html={s} />)}
            </ol>
          </div>
        )}

      </div>

      <!-- Sticky TOC (right column, only when 4+ headings) -->
      {showToc && (
        <aside class="toc-sidebar">
          <div class="toc">
            <p class="toc-label">Contents</p>
            <ol class="toc-list">
              {tocItems.map(item => (
                <li><a href={`#${item.id}`}>{item.text}</a></li>
              ))}
            </ol>
          </div>
        </aside>
      )}

    </div>

    <div class="back-bar">
      <a href="/people">← Back to All People</a>
    </div>

  </div>

</BaseLayout>

<style>
  /* ── Page wrapper ────────────────────────────────────── */
  .person-page {
    max-width: var(--max-wide);
    margin:    0 auto;
    padding:   0 2rem 4rem;
  }

  /* ── Breadcrumb ──────────────────────────────────────── */
  .breadcrumb {
    padding:        1rem 0;
    font-family:    var(--sans);
    font-size:      0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color:          var(--ink-light);
    display:        flex;
    gap:            0.5rem;
    align-items:    center;
    border-bottom:  1px solid var(--rule);
    margin-bottom:  2rem;
  }
  .breadcrumb a { color: var(--ink-light); }
  .breadcrumb a:hover { color: var(--accent); text-decoration: none; }
  .sep { opacity: 0.4; }

  /* ── Person header ───────────────────────────────────── */
  .person-header {
    max-width:     var(--max);
    margin-bottom: 2rem;
  }

  .person-era {
    font-family:    var(--sans);
    font-size:      0.68rem;
    font-weight:    600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color:          var(--accent);
    margin-bottom:  0.75rem;
    display:        flex;
    align-items:    center;
    gap:            0.75rem;
  }
  .person-era::after {
    content:    '';
    flex:       1;
    height:     1px;
    background: var(--rule);
    max-width:  60px;
  }

  .person-header h1 {
    font-family:   var(--serif);
    font-size:     clamp(1.8rem, 4vw, 2.8rem);
    font-weight:   700;
    line-height:   1.2;
    color:         var(--ink);
    margin-bottom: 0.75rem;
  }

  .person-epithet {
    font-family:   var(--serif);
    font-size:     1.1rem;
    font-style:    italic;
    color:         var(--ink-light);
    margin-bottom: 1.5rem;
    line-height:   1.5;
  }

  .person-meta {
    display:       flex;
    gap:           2rem;
    flex-wrap:     wrap;
    padding:       1rem 0;
    border-top:    1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .meta-item {
    font-family:    var(--sans);
    font-size:      0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color:          var(--ink-light);
  }
  .meta-item strong {
    display:       block;
    font-weight:   600;
    color:         var(--ink);
    margin-bottom: 0.1rem;
  }

  /* ── Lead image ──────────────────────────────────────── */
  .lead-image { margin: 2rem 0; max-width: var(--max); }
  .lead-image img {
    width:      100%;
    max-height: 480px;
    object-fit: cover;
  }
  .lead-image figcaption {
    font-family:    var(--sans);
    font-size:      0.72rem;
    letter-spacing: 0.05em;
    color:          var(--ink-light);
    padding:        0.6rem 0 0;
    border-bottom:  1px solid var(--rule);
  }

  /* ── Two-column layout ───────────────────────────────── */
  .content-columns {
    display:   block;
    margin-top: 2rem;
  }

  .content-columns.has-toc {
    display:               grid;
    grid-template-columns: 1fr 220px;
    gap:                   3rem;
    align-items:           start;
  }

  /* ── Article body ────────────────────────────────────── */
  .person-body :global(p) {
    margin-bottom: 1.5rem;
    font-size:     1rem;
    line-height:   1.8;
  }
  .person-body :global(h2) {
    font-family:       var(--serif);
    font-size:         1.5rem;
    font-weight:       700;
    color:             var(--ink);
    margin:            2.5rem 0 1rem;
    padding-top:       0.5rem;
    border-top:        1px solid var(--rule);
    scroll-margin-top: 5rem;
  }
  .person-body :global(h3) {
    font-family:       var(--serif);
    font-size:         1.15rem;
    font-style:        italic;
    color:             var(--ink);
    margin:            2rem 0 0.75rem;
    scroll-margin-top: 5rem;
  }
  .person-body :global(blockquote) {
    margin:      2.5rem 0;
    padding:     1.5rem 2rem;
    border-left: 4px solid var(--gold);
    background:  var(--paper-dark);
    font-family: var(--serif);
    font-size:   1.15rem;
    font-style:  italic;
    color:       var(--ink);
    line-height: 1.6;
  }
  .person-body :global(figure.inline) {
    float:     right;
    margin:    0 0 1.5rem 2rem;
    max-width: 240px;
    clear:     right;
  }
  .person-body :global(figure.inline img) { border: 1px solid var(--rule); }
  .person-body :global(figure.full)       { margin: 2rem 0; }
  .person-body :global(figure.full img)   { width: 100%; }

  /* ── Sticky TOC sidebar ──────────────────────────────── */
  .toc-sidebar {
    position: sticky;
    top:      5rem;
  }

  .toc {
    background:  var(--white);
    border:      1px solid var(--rule);
    border-left: 3px solid var(--gold);
    padding:     1rem 1rem 1rem 1.25rem;
  }

  .toc-label {
    font-family:    var(--sans);
    font-size:      0.62rem;
    font-weight:    600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color:          var(--ink-light);
    margin-bottom:  0.6rem;
  }

  .toc-list {
    list-style-type: decimal;
    padding-left:    1.1rem;
    margin:          0;
  }

  .toc-list li {
    font-family:   var(--sans);
    font-size:     0.75rem;
    line-height:   1.4;
    padding:       0.2rem 0;
    color:         var(--ink);
  }

  .toc-list a {
    color:           var(--ink-light);
    text-decoration: none;
    transition:      color 0.15s;
  }
  .toc-list a:hover { color: var(--accent); }

  /* ── Family callout ──────────────────────────────────── */
  .family-callout {
    background:  var(--white);
    border:      1px solid var(--rule);
    border-top:  3px solid var(--accent2);
    padding:     1.25rem 1.5rem;
    margin:      0 0 2.5rem;
  }
  .family-callout h4 {
    font-family:    var(--sans);
    font-size:      0.65rem;
    font-weight:    600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color:          var(--accent2);
    margin-bottom:  0.75rem;
  }
  .family-list {
    list-style:     none;
    display:        flex;
    flex-direction: column;
    gap:            0.5rem;
  }
  .family-list li {
    font-size:   0.88rem;
    display:     flex;
    gap:         0.75rem;
    align-items: baseline;
  }
  .family-list li strong {
    font-family:    var(--sans);
    font-size:      0.6rem;
    font-weight:    600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color:          var(--ink-light);
    white-space:    nowrap;
    min-width:      3.5rem;
  }
  .family-list li a { color: var(--ink); font-weight: 700; }
  .family-list li a:hover { color: var(--accent); }

  /* ── Sources ─────────────────────────────────────────── */
  .sources {
    margin-top:  3rem;
    padding-top: 1.5rem;
    border-top:  2px solid var(--rule);
  }
  .sources h4 {
    font-family:    var(--sans);
    font-size:      0.65rem;
    font-weight:    600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color:          var(--ink-light);
    margin-bottom:  0.75rem;
  }
  .sources ol {
    padding-left:   1.25rem;
    font-size:      0.82rem;
    color:          var(--ink-light);
    line-height:    1.6;
    display:        flex;
    flex-direction: column;
    gap:            0.4rem;
  }

  /* ── Back bar ────────────────────────────────────────── */
  .back-bar {
    margin-top:  3rem;
    padding-top: 1.5rem;
    border-top:  1px solid var(--rule);
    text-align:  center;
  }
  .back-bar a {
    font-family:    var(--sans);
    font-size:      0.72rem;
    font-weight:    600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color:          var(--accent);
  }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 800px) {
    .content-columns.has-toc {
      grid-template-columns: 1fr;
    }
    .toc-sidebar {
      position: static;
      order:    -1;
    }
    .person-body :global(figure.inline) {
      float:     none;
      max-width: 100%;
      margin:    1.5rem 0;
    }
  }
</style>

<script>
  // Add IDs to rendered h2 headings to match TOC anchor links
  document.querySelectorAll('.person-body h2').forEach((h, i) => {
    h.id = 'section-' + (i + 1);
  });
</script>
