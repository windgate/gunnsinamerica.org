---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const people = await getCollection('people');
  return people.map(person => ({
    params: { slug: person.slug },
    props:  { person },
  }));
}

const { person } = Astro.props;
const { Content } = await person.render();
const d = person.data;

const resolve = async (slugs: string[] | undefined) =>
  slugs
    ? (await Promise.all(
        slugs
          .filter(s => typeof s === 'string' && s.trim() !== '')
          .map(s => getEntry('people', s).catch(() => null))
      )).filter(Boolean)
    : [];
const parents  = await resolve(d.parents);
const spouse   = await resolve(d.spouse);
const children = await resolve(d.children);
const hasFamily = parents.length + spouse.length + children.length > 0;
---

<BaseLayout title={d.title} description={d.epithet ?? [d.birth, d.death].filter(Boolean).join(' – ')}>

  <div class="person-page">

    <!-- Breadcrumb -->
    <div class="breadcrumb">
      <a href="/">Home</a>
      <span class="sep">›</span>
      <a href="/people">People</a>
      <span class="sep">›</span>
      <span>{d.title}</span>
    </div>

    <!-- Person header -->
    <header class="person-header">
      {d.era && <div class="person-era">{d.eraLabel ?? d.era}</div>}
      <h1>{d.title}</h1>
      {d.epithet && <p class="person-epithet">{d.epithet}</p>}
      <div class="person-meta">
        {d.birth      && <div class="meta-item"><strong>Born</strong>{d.birth}</div>}
        {d.death      && <div class="meta-item"><strong>Died</strong>{d.death}</div>}
        {d.birthplace && <div class="meta-item"><strong>Birthplace</strong>{d.birthplace}</div>}
        {d.deathplace && <div class="meta-item"><strong>Deathplace</strong>{d.deathplace}</div>}
      </div>
    </header>

    <!-- Portrait / lead image (optional) -->
    {d.leadImage && (
      <figure class="lead-image">
        <img src={d.leadImage} alt={d.leadImageAlt ?? d.title} />
        {d.leadImageCaption && <figcaption>{d.leadImageCaption}</figcaption>}
      </figure>
    )}

    <!-- Table of Contents — built by JS, shown only when 4+ h2 headings exist -->
    <nav class="toc" id="toc" aria-label="Table of contents" hidden>
      <p class="toc-label">Contents</p>
      <ol class="toc-list" id="toc-list"></ol>
    </nav>

    <!-- Biography body -->
    <div class="person-body" id="person-body">

      <!-- Family relations callout -->
      {hasFamily && (
        <div class="family-callout">
          <h4>Family</h4>
          <ul class="family-list">
            {parents.map(p  => (
              <li><strong>Parent</strong><a href={`/people/${p.slug}`}>{p.data.title}</a></li>
            ))}
            {spouse.map(p   => (
              <li><strong>Spouse</strong><a href={`/people/${p.slug}`}>{p.data.title}</a></li>
            ))}
            {children.map(p => (
              <li><strong>Child</strong><a href={`/people/${p.slug}`}>{p.data.title}</a></li>
            ))}
          </ul>
        </div>
      )}

      <Content />

      <!-- Sources -->
      {d.sources && d.sources.length > 0 && (
        <div class="sources">
          <h4>Sources &amp; Notes</h4>
          <ol>
            {d.sources.map(s => <li set:html={s} />)}
          </ol>
        </div>
      )}

    </div>

    <!-- Back bar -->
    <div class="back-bar">
      <a href="/people">← Back to All People</a>
    </div>

  </div>

</BaseLayout>

<style>
  /* ── Page wrapper ────────────────────────────────────── */
  .person-page {
    max-width: var(--max);
    margin:    0 auto;
    padding:   0 2rem 4rem;
  }

  /* ── Breadcrumb ──────────────────────────────────────── */
  .breadcrumb {
    padding:        1rem 0;
    font-family:    var(--sans);
    font-size:      0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color:          var(--ink-light);
    display:        flex;
    gap:            0.5rem;
    align-items:    center;
    border-bottom:  1px solid var(--rule);
    margin-bottom:  2rem;
  }
  .breadcrumb a { color: var(--ink-light); }
  .breadcrumb a:hover { color: var(--accent); text-decoration: none; }
  .sep { opacity: 0.4; }

  /* ── Person header ───────────────────────────────────── */
  .person-header { margin-bottom: 2rem; }

  .person-era {
    font-family:    var(--sans);
    font-size:      0.68rem;
    font-weight:    600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color:          var(--accent);
    margin-bottom:  0.75rem;
    display:        flex;
    align-items:    center;
    gap:            0.75rem;
  }
  .person-era::after {
    content:    '';
    flex:       1;
    height:     1px;
    background: var(--rule);
    max-width:  60px;
  }

  .person-header h1 {
    font-family:   var(--serif);
    font-size:     clamp(1.8rem, 4vw, 2.8rem);
    font-weight:   700;
    line-height:   1.2;
    color:         var(--ink);
    margin-bottom: 0.75rem;
  }

  .person-epithet {
    font-family:   var(--serif);
    font-size:     1.1rem;
    font-style:    italic;
    color:         var(--ink-light);
    margin-bottom: 1.5rem;
    line-height:   1.5;
  }

  .person-meta {
    display:       flex;
    gap:           2rem;
    flex-wrap:     wrap;
    padding:       1rem 0;
    border-top:    1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .meta-item {
    font-family:    var(--sans);
    font-size:      0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color:          var(--ink-light);
  }
  .meta-item strong {
    display:       block;
    font-weight:   600;
    color:         var(--ink);
    margin-bottom: 0.1rem;
  }

  /* ── Lead image ──────────────────────────────────────── */
  .lead-image { margin: 2rem 0; }
  .lead-image img {
    width:      100%;
    max-height: 480px;
    object-fit: cover;
  }
  .lead-image figcaption {
    font-family:    var(--sans);
    font-size:      0.72rem;
    letter-spacing: 0.05em;
    color:          var(--ink-light);
    padding:        0.6rem 0 0;
    border-bottom:  1px solid var(--rule);
  }

  /* ── Table of Contents ───────────────────────────────── */
  .toc {
    margin:        2rem 0;
    padding:       1.25rem 1.5rem;
    background:    var(--white);
    border:        1px solid var(--rule);
    border-left:   3px solid var(--gold);
  }
  .toc[hidden] { display: none; }

  .toc-label {
    font-family:    var(--sans);
    font-size:      0.65rem;
    font-weight:    600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color:          var(--ink-light);
    margin-bottom:  0.75rem;
  }

  .toc-list {
    list-style:     decimal;
    padding-left:   1.25rem;
    columns:        2;
    column-gap:     2rem;
  }
  .toc-list li {
    font-family:  var(--body);
    font-size:    0.88rem;
    line-height:  1.5;
    padding:      0.15rem 0;
    break-inside: avoid;
  }
  .toc-list a { color: var(--accent); text-decoration: none; }
  .toc-list a:hover { text-decoration: underline; }

  @media (max-width: 500px) {
    .toc-list { columns: 1; }
  }

  /* ── Body ────────────────────────────────────────────── */
  .person-body { margin-top: 2rem; }

  .person-body :global(p)  { margin-bottom: 1.5rem; font-size: 1rem; line-height: 1.8; }

  .person-body :global(h2) {
    font-family:       var(--serif);
    font-size:         1.5rem;
    font-weight:       700;
    color:             var(--ink);
    margin:            2.5rem 0 1rem;
    padding-top:       0.5rem;
    border-top:        1px solid var(--rule);
    scroll-margin-top: 5rem;
  }
  .person-body :global(h3) {
    font-family:       var(--serif);
    font-size:         1.15rem;
    font-style:        italic;
    color:             var(--ink);
    margin:            2rem 0 0.75rem;
    scroll-margin-top: 5rem;
  }

  .person-body :global(blockquote) {
    margin:      2.5rem 0;
    padding:     1.5rem 2rem;
    border-left: 4px solid var(--gold);
    background:  var(--paper-dark);
    font-family: var(--serif);
    font-size:   1.15rem;
    font-style:  italic;
    color:       var(--ink);
    line-height: 1.6;
  }

  .person-body :global(figure.inline) {
    float:     right;
    margin:    0 0 1.5rem 2rem;
    max-width: 280px;
    clear:     right;
  }
  .person-body :global(figure.inline img) { border: 1px solid var(--rule); }
  .person-body :global(figure.full)       { margin: 2rem -2rem; }
  .person-body :global(figure.full img)   { width: 100%; }

  /* ── Family callout ──────────────────────────────────── */
  .family-callout {
    background:  var(--white);
    border:      1px solid var(--rule);
    border-top:  3px solid var(--accent2);
    padding:     1.25rem 1.5rem;
    margin:      0 0 2.5rem;
  }
  .family-callout h4 {
    font-family:    var(--sans);
    font-size:      0.65rem;
    font-weight:    600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color:          var(--accent2);
    margin-bottom:  0.75rem;
  }
  .family-list {
    list-style:     none;
    display:        flex;
    flex-direction: column;
    gap:            0.5rem;
  }
  .family-list li {
    font-size:   0.88rem;
    display:     flex;
    gap:         0.75rem;
    align-items: baseline;
  }
  .family-list li strong {
    font-family:    var(--sans);
    font-size:      0.6rem;
    font-weight:    600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color:          var(--ink-light);
    white-space:    nowrap;
    min-width:      3.5rem;
  }
  .family-list li a { color: var(--ink); font-weight: 700; }
  .family-list li a:hover { color: var(--accent); }

  /* ── Sources ─────────────────────────────────────────── */
  .sources {
    margin-top:  3rem;
    padding-top: 1.5rem;
    border-top:  2px solid var(--rule);
  }
  .sources h4 {
    font-family:    var(--sans);
    font-size:      0.65rem;
    font-weight:    600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color:          var(--ink-light);
    margin-bottom:  0.75rem;
  }
  .sources ol {
    padding-left:   1.25rem;
    font-size:      0.82rem;
    color:          var(--ink-light);
    line-height:    1.6;
    display:        flex;
    flex-direction: column;
    gap:            0.4rem;
  }

  /* ── Back bar ────────────────────────────────────────── */
  .back-bar {
    margin-top:  3rem;
    padding-top: 1.5rem;
    border-top:  1px solid var(--rule);
    text-align:  center;
  }
  .back-bar a {
    font-family:    var(--sans);
    font-size:      0.72rem;
    font-weight:    600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color:          var(--accent);
  }

  @media (max-width: 600px) {
    .person-body :global(figure.inline) { float: none; max-width: 100%; margin: 1.5rem 0; }
  }
</style>

<script>
  const MIN_HEADINGS = 4;
  const body    = document.getElementById('person-body');
  const toc     = document.getElementById('toc');
  const tocList = document.getElementById('toc-list');

  if (body && toc && tocList) {
    const headings = Array.from(body.querySelectorAll('h2'));
    if (headings.length >= MIN_HEADINGS) {
      headings.forEach((h, i) => {
        if (!h.id) h.id = 'section-' + (i + 1);
        const li = document.createElement('li');
        const a  = document.createElement('a');
        a.href        = '#' + h.id;
        a.textContent = h.textContent ?? '';
        li.appendChild(a);
        tocList.appendChild(li);
      });
      toc.removeAttribute('hidden');
    }
  }
</script>