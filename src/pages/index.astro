---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FamilyRecollections from '../components/FamilyRecollections.astro';
import BookTeaser from '../components/BookTeaser.astro';

// Pull featured entries from BOTH the articles and voices collections.
const featuredArticles = await getCollection('articles', ({ data }) => data.featured);
const featuredVoices   = await getCollection('voices',   ({ data }) => data.featured);

const featured = [...featuredArticles, ...featuredVoices]
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const timeline = [
  { label: 'Colonial',    year: '1635'  },
  { label: 'Revolution',  year: '1775'  },
  { label: 'War of 1812', year: '1812'  },
  { label: 'Frontier',    year: '1830s' },
  { label: 'Civil War',   year: '1861'  },
  { label: 'Modern Era',  year: '1900s' },
];

const placeholders = [
  { era: 'Colonial · 1635',          slug: 'jasper-gunn-arrives', title: 'Jasper Gunn Arrives in New England',              excerpt: 'A young man leaves England for an uncertain shore. What brought him, what he found, and how he put down roots that would hold for centuries.' },
  { era: 'Revolutionary War · 1776', slug: 'gunns-at-lexington',  title: 'The Gunns at Lexington and Beyond',               excerpt: 'When the colonies rose against the Crown, members of the Gunn family answered. Their roles, their sacrifices, and their aftermath.' },
  { era: 'Frontier · 1840s',         slug: 'moving-west',         title: 'Moving West: The Family Crosses the Appalachians', excerpt: 'Successive generations pushed further from New England, following the promise of land, opportunity, and reinvention.' },
  { era: 'Modern Era · Early 1900s', slug: 'nina-belle-pyle',     title: 'Nina Belle Pyle: The Last Gunn',                  excerpt: 'The story closes with a grandmother and her family — living memory of a line that stretches back almost four hundred years.' },
];

// Normalize the two collections' differing field names into one card shape.
// Articles use eraLabel/subtitle; voices use era/excerpt. The ?? fallbacks
// let a single mapping serve both. The href is built from each entry's own
// collection so voices cards link to /voices/… and articles to /articles/….
const cards = featured.length > 0
  ? featured.map(entry => ({
      era:     entry.data.eraLabel ?? entry.data.era,
      title:   entry.data.title,
      excerpt: entry.data.subtitle ?? entry.data.excerpt,
      href:    `/${entry.collection}/${entry.slug}`,
    }))
  : placeholders.map(p => ({ ...p, href: `/articles/${p.slug}` }));
---

<BaseLayout>

  <section class="hero">
    <div class="hero-eyebrow">A Family History · 1635 to the Present</div>
    <h1>Gunns<br><em>in America</em></h1>
    <div class="hero-sub">From the colonies to the modern era</div>
    <div class="hero-rule"></div>
    <p class="hero-desc">
      In 1635, Jasper Gunn sailed from England and set foot in New England — one family's
      beginning in a world being made. This site is the companion to the book, collecting
      the stories, documents, and faces that couldn't fit between two covers.
    </p>
    <div class="hero-dates">1635 &nbsp;·&nbsp; Colonial &nbsp;·&nbsp; Revolution &nbsp;·&nbsp; Frontier &nbsp;·&nbsp; Civil War &nbsp;·&nbsp; Modern Era</div>
  </section>

  <div class="timeline-band">
    <div class="timeline-inner">
      {timeline.map(t => (
        <a href="/articles" class="tl-era">
          <div class="tl-dot"></div>
          <div class="tl-label">{t.label}</div>
          <div class="tl-year">{t.year}</div>
        </a>
      ))}
    </div>
  </div>

  <div class="section">
    <div class="section-header">
      <h2>Featured Stories</h2>
      <span class="count">From the Archives</span>
    </div>
    <div class="feature-grid">
      {cards.map(c => (
        <a href={c.href} class="feature-card">
          <div class="card-era">{c.era}</div>
          <h3>{c.title}</h3>
          <p>{c.excerpt}</p>
          <span class="card-link">Read the story →</span>
        </a>
      ))}
    </div>
  </div>

  <FamilyRecollections />

  <BookTeaser />

</BaseLayout>

<style>
  .hero {
    position:            relative;
    background-image:    url('/images/hero-gunns1920x600.jpg');
    background-size:     cover;
    background-position: center center;
    background-repeat:   no-repeat;
    color:               var(--paper);
    padding:             6rem 2rem 5rem;
    text-align:          center;
    overflow:            hidden;
  }
  .hero::before {
    content:        '';
    position:       absolute;
    inset:          0;
    background:     rgba(20, 14, 8, 0.55);
    pointer-events: none;
  }
  .hero::after {
    content:  '';
    position: absolute;
    inset:    0;
    background: repeating-linear-gradient(
      0deg, transparent, transparent 39px,
      rgba(200,186,160,0.04) 39px, rgba(200,186,160,0.04) 40px
    );
    pointer-events: none;
  }
  .hero > * { position: relative; z-index: 1; }
  .hero-eyebrow {
    font-family: var(--sans); font-size: 0.72rem; font-weight: 600;
    letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--gold); margin-bottom: 1.25rem;
  }
  .hero h1 {
    font-family: var(--serif); font-size: clamp(2.4rem, 6vw, 4.2rem);
    font-weight: 700; line-height: 1.15; margin-bottom: 0.5rem; color: var(--paper);
  }
  .hero h1 em { font-style: italic; color: var(--gold); }
  .hero-sub {
    font-family: var(--serif); font-size: 1.15rem; font-style: italic;
    color: var(--rule); margin-bottom: 2rem;
  }
  .hero-rule { width: 80px; height: 2px; background: var(--gold); margin: 0 auto 2rem; }
  .hero-desc {
    max-width: 640px; margin: 0 auto 2.5rem; font-size: 1rem;
    color: var(--paper-dark); line-height: 1.8;
  }
  .hero-dates {
    font-family: var(--sans); font-size: 0.75rem; letter-spacing: 0.15em;
    text-transform: uppercase; color: var(--gold); opacity: 0.7;
  }

  .timeline-band { background: var(--accent); padding: 1.5rem 2rem; overflow-x: auto; }
  .timeline-inner {
    display: flex; align-items: center; max-width: var(--max);
    margin: 0 auto; position: relative;
  }
  .timeline-inner::before {
    content: ''; position: absolute; top: 50%; left: 0; right: 0;
    height: 1px; background: rgba(255,255,255,0.25); transform: translateY(-50%);
  }
  .tl-era {
    flex: 1; text-align: center; position: relative; z-index: 1;
    padding: 0.25rem 0.5rem; text-decoration: none;
  }
  .tl-dot {
    width: 10px; height: 10px; background: var(--gold); border-radius: 50%;
    margin: 0 auto 0.4rem; transition: transform 0.2s;
  }
  .tl-era:hover .tl-dot { transform: scale(1.5); }
  .tl-label {
    font-family: var(--sans); font-size: 0.63rem; font-weight: 600;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: rgba(245,240,232,0.85); white-space: nowrap; display: block;
  }
  .tl-year { font-family: var(--serif); font-size: 0.72rem; color: var(--gold); display: block; }

  .section { max-width: var(--max); margin: 0 auto; padding: 4rem 2rem; }
  .section-header {
    display: flex; align-items: baseline; gap: 1.5rem;
    margin-bottom: 2.5rem; border-bottom: 1px solid var(--rule); padding-bottom: 1rem;
  }
  .section-header h2 { font-family: var(--serif); font-size: 2rem; font-weight: 700; color: var(--ink); }
  .count { font-family: var(--sans); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-light); }

  .feature-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; }
  .feature-card {
    background: var(--white); border: 1px solid var(--rule); border-top: 3px solid var(--accent);
    padding: 1.75rem; text-decoration: none; color: var(--ink);
    display: flex; flex-direction: column; transition: box-shadow 0.2s, transform 0.2s;
  }
  .feature-card:hover { box-shadow: 0 6px 24px rgba(28,24,20,0.12); transform: translateY(-2px); text-decoration: none; }
  .card-era { font-family: var(--sans); font-size: 0.65rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.5rem; }
  .feature-card h3 { font-family: var(--serif); font-size: 1.2rem; line-height: 1.3; margin-bottom: 0.75rem; color: var(--ink); }
  .feature-card p { font-size: 0.88rem; color: var(--ink-light); line-height: 1.65; flex: 1; }
  .card-link { display: inline-block; margin-top: 1rem; font-family: var(--sans); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
</style>