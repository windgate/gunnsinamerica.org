---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Gallery images are managed as a simple JSON data file for now.
// Move to a content collection when the gallery grows.
const eras = ['All', 'Colonial', 'Revolutionary', 'War of 1812', 'Frontier', 'Civil War', 'Modern'];
---

<BaseLayout title="Family Gallery" description="Portraits, photographs, and documents spanning four centuries of Gunn family history.">

  <div class="gallery-page">

    <header class="page-header">
      <p class="eyebrow">Gunn Family History</p>
      <h1>Family Gallery</h1>
      <p class="page-desc">
        Portraits, photographs, and documents spanning four centuries —
        the faces behind the family history.
      </p>
    </header>

    <div class="filter-bar" role="group" aria-label="Filter by era">
      {eras.map(era => (
        <button class:list={['filter-btn', { active: era === 'All' }]} data-era={era}>
          {era}
        </button>
      ))}
    </div>

    <!-- Gallery grid — images injected by JS from gallery-data.json -->
    <div class="gallery-grid" id="gallery-grid">
      <p class="empty" id="gallery-empty">
        The gallery is being assembled. Photographs and documents will appear here
        as they are digitized and catalogued.
      </p>
    </div>

    <!-- Lightbox -->
    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Image viewer" hidden>
      <button class="lb-close" id="lb-close" aria-label="Close image">✕</button>
      <img class="lb-img" id="lb-img" src="" alt="" />
      <p class="lb-caption" id="lb-caption"></p>
    </div>

  </div>

</BaseLayout>

<style>
  .gallery-page {
    max-width: var(--max-wide);
    margin:    0 auto;
    padding:   clamp(2rem, 5vw, 4rem) 2rem;
  }

  .page-header {
    border-bottom:  1px solid var(--rule);
    padding-bottom: 2rem;
    margin-bottom:  2rem;
  }
  .eyebrow {
    font-family:    var(--sans);
    font-size:      0.68rem;
    font-weight:    600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color:          var(--gold);
    margin-bottom:  0.4rem;
  }
  .page-header h1 {
    font-family:   var(--serif);
    font-size:     clamp(2rem, 5vw, 3rem);
    font-weight:   700;
    margin-bottom: 0.5rem;
  }
  .page-desc {
    font-size:   1rem;
    color:       var(--ink-light);
    max-width:   500px;
    line-height: 1.7;
  }

  .filter-bar {
    display:       flex;
    flex-wrap:     wrap;
    gap:           0.5rem;
    margin-bottom: 2.5rem;
  }
  .filter-btn {
    font-family:    var(--sans);
    font-size:      0.68rem;
    font-weight:    600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding:        0.4rem 1rem;
    border:         1px solid var(--rule);
    background:     transparent;
    color:          var(--ink-light);
    cursor:         pointer;
    transition:     all 0.15s;
  }
  .filter-btn:hover  { border-color: var(--accent); color: var(--ink); }
  .filter-btn.active { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  .gallery-grid {
    display:               grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap:                   1.5rem;
  }

  /* Injected figure styles */
  :global(.gallery-item)            { display: flex; flex-direction: column; gap: 0.5rem; }
  :global(.gallery-item[hidden])    { display: none; }
  :global(.gallery-thumb)           { background: none; border: 1px solid var(--rule); padding: 0; cursor: pointer; overflow: hidden; aspect-ratio: 3/4; }
  :global(.gallery-thumb img)       { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
  :global(.gallery-thumb:hover img) { transform: scale(1.04); }
  :global(.gallery-item figcaption) { font-family: var(--sans); font-size: 0.72rem; color: var(--ink-light); line-height: 1.4; }
  :global(.gallery-item .img-year)  { display: block; font-size: 0.65rem; color: var(--ink-light); opacity: 0.7; margin-top: 2px; }

  .empty { color: var(--ink-light); font-style: italic; grid-column: 1 / -1; padding: 2rem 0; }

  /* Lightbox */
  .lightbox {
    position:       fixed;
    inset:          0;
    background:     rgba(28,24,20,0.94);
    display:        flex;
    flex-direction: column;
    align-items:    center;
    justify-content: center;
    z-index:        1000;
    padding:        2rem;
    gap:            1rem;
  }
  .lightbox[hidden] { display: none; }

  .lb-close {
    position:   absolute;
    top:        1.25rem;
    right:      1.5rem;
    background: none;
    border:     none;
    color:      var(--rule);
    font-size:  1.5rem;
    cursor:     pointer;
    line-height: 1;
    transition: color 0.15s;
  }
  .lb-close:hover { color: var(--paper); }

  .lb-img {
    max-width:  min(840px, 90vw);
    max-height: 78vh;
    object-fit: contain;
    border:     1px solid #555;
  }

  .lb-caption {
    font-family:    var(--sans);
    font-size:      0.75rem;
    letter-spacing: 0.05em;
    color:          var(--rule);
    text-align:     center;
    max-width:      560px;
  }
</style>

<script>
  // Load gallery images from /gallery-data.json (place in public/)
  // Format: [{ title, era, year, image, caption }]
  async function loadGallery() {
    const grid  = document.getElementById('gallery-grid')!;
    const empty = document.getElementById('gallery-empty');

    try {
      const res  = await fetch('/gallery-data.json');
      if (!res.ok) return;                       // no data file yet — show empty state
      const data: Array<{ title: string; era: string; year?: string; image: string; caption?: string }> = await res.json();
      if (!data.length) return;

      empty?.remove();

      data.forEach(item => {
        const fig = document.createElement('figure');
        fig.className = 'gallery-item';
        fig.dataset.era = item.era;
        fig.innerHTML = `
          <button class="gallery-thumb" data-src="${item.image}" data-caption="${item.caption ?? item.title}">
            <img src="${item.image}" alt="${item.caption ?? item.title}" loading="lazy" />
          </button>
          <figcaption>
            ${item.title}
            ${item.year ? `<span class="img-year">${item.year}</span>` : ''}
          </figcaption>`;
        grid.appendChild(fig);
      });

      attachHandlers();
    } catch (_) { /* no data file yet */ }
  }

  function attachHandlers() {
    // Era filter
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const items   = document.querySelectorAll<HTMLElement>('.gallery-item');
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const era = btn.dataset.era;
        items.forEach(item => item.toggleAttribute('hidden', era !== 'All' && item.dataset.era !== era));
      });
    });

    // Lightbox
    const lb      = document.getElementById('lightbox')!;
    const lbImg   = document.getElementById('lb-img') as HTMLImageElement;
    const lbCap   = document.getElementById('lb-caption')!;
    const lbClose = document.getElementById('lb-close')!;

    document.querySelectorAll<HTMLButtonElement>('.gallery-thumb').forEach(btn => {
      btn.addEventListener('click', () => {
        lbImg.src = btn.dataset.src ?? '';
        lbImg.alt = btn.dataset.caption ?? '';
        lbCap.textContent = btn.dataset.caption ?? '';
        lb.removeAttribute('hidden');
        document.body.style.overflow = 'hidden';
      });
    });

    const close = () => { lb.setAttribute('hidden', ''); lbImg.src = ''; document.body.style.overflow = ''; };
    lbClose.addEventListener('click', close);
    lb.addEventListener('click', e => { if (e.target === lb) close(); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
  }

  loadGallery();
</script>
