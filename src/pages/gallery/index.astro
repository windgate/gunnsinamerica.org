---
import BaseLayout from '../../layouts/BaseLayout.astro';

const eras   = ['All', 'Colonial', 'Revolutionary', 'War of 1812', 'Frontier', 'Civil War', 'Modern'];
const types  = ['All', 'Photographs', 'Documents', 'Artwork', 'Maps', 'Artifacts', 'Places', 'Other'];
---

<BaseLayout
  title="Family Gallery"
  description="Photographs, documents, artwork, maps, and artifacts spanning four centuries of Gunn family history."
>

  <div class="gallery-page">

    <header class="page-header">
      <p class="eyebrow">Gunn Family History</p>
      <h1>Family Gallery</h1>
      <p class="page-desc">
        Photographs, documents, artwork, maps, and artifacts spanning
        four centuries — the visual record of the Gunn family in America.
      </p>
    </header>

    <!-- Filter controls -->
    <div class="filters">
      <div class="filter-group">
        <span class="filter-label">Era</span>
        <div class="filter-bar" role="group" aria-label="Filter by era">
          {eras.map(era => (
            <button class:list={['filter-btn', { active: era === 'All' }]} data-era={era}>
              {era}
            </button>
          ))}
        </div>
      </div>
      <div class="filter-group">
        <span class="filter-label">Type</span>
        <div class="filter-bar" role="group" aria-label="Filter by type">
          {types.map(type => (
            <button class:list={['filter-btn', 'type-btn', { active: type === 'All' }]} data-type={type}>
              {type}
            </button>
          ))}
        </div>
      </div>
      <div class="filter-summary">
        <span id="gallery-count">Loading…</span>
        <button class="reset-btn" id="reset-btn">Reset filters</button>
      </div>
    </div>

    <!-- Gallery grid — populated by JS from gallery-data.json -->
    <div class="gallery-grid" id="gallery-grid">
      <p class="empty" id="gallery-empty" style="display:none">
        No items match the selected filters.
      </p>
    </div>

    <!-- Lightbox -->
    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Image viewer">
      <button class="lb-close" id="lb-close" aria-label="Close">✕</button>
      <div class="lb-inner">
        <img class="lb-img" id="lb-img" src="" alt="" />
        <div class="lb-meta">
          <p class="lb-title" id="lb-title"></p>
          <p class="lb-caption" id="lb-caption"></p>
          <div class="lb-tags" id="lb-tags"></div>
        </div>
      </div>
    </div>

  </div>

</BaseLayout>

<style>
  .gallery-page {
    max-width: var(--max-wide);
    margin:    0 auto;
    padding:   clamp(2rem, 5vw, 4rem) 2rem;
  }

  /* Header */
  .page-header {
    border-bottom:  1px solid var(--rule);
    padding-bottom: 2rem;
    margin-bottom:  2rem;
  }
  .eyebrow {
    font-family:    var(--sans);
    font-size:      0.68rem;
    font-weight:    600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color:          var(--gold);
    margin-bottom:  0.4rem;
  }
  .page-header h1 {
    font-family:   var(--serif);
    font-size:     clamp(2rem, 5vw, 3rem);
    font-weight:   700;
    margin-bottom: 0.5rem;
  }
  .page-desc {
    font-size:   1rem;
    color:       var(--ink-light);
    max-width:   560px;
    line-height: 1.7;
  }

  /* Filters */
  .filters {
    margin-bottom: 2rem;
    display:       flex;
    flex-direction: column;
    gap:           0.75rem;
  }
  .filter-group {
    display:     flex;
    align-items: center;
    gap:         1rem;
    flex-wrap:   wrap;
  }
  .filter-label {
    font-family:    var(--sans);
    font-size:      0.65rem;
    font-weight:    600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color:          var(--ink-light);
    min-width:      3rem;
  }
  .filter-bar {
    display:  flex;
    gap:      0.4rem;
    flex-wrap: wrap;
  }
  .filter-btn {
    font-family:    var(--sans);
    font-size:      0.65rem;
    font-weight:    600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding:        0.3rem 0.75rem;
    border:         1px solid var(--rule);
    background:     transparent;
    color:          var(--ink-light);
    cursor:         pointer;
    transition:     all 0.15s;
  }
  .filter-btn:hover  { border-color: var(--accent); color: var(--ink); }
  .filter-btn.active { background: var(--accent); border-color: var(--accent); color: var(--white); }

  .filter-summary {
    display:     flex;
    align-items: center;
    gap:         1.5rem;
    padding-top: 0.25rem;
  }
  #gallery-count {
    font-family:    var(--sans);
    font-size:      0.72rem;
    color:          var(--ink-light);
    letter-spacing: 0.04em;
  }
  .reset-btn {
    font-family:    var(--sans);
    font-size:      0.65rem;
    font-weight:    600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background:     none;
    border:         none;
    color:          var(--accent);
    cursor:         pointer;
    padding:        0;
    text-decoration: underline;
  }
  .reset-btn:hover { color: var(--ink); }

  /* Gallery grid */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap:     1.5rem;
  }

  /* Cards — injected by JS */
  :global(.g-card)            { display: flex; flex-direction: column; gap: 0.5rem; cursor: pointer; }
  :global(.g-card[hidden])    { display: none; }
  :global(.g-thumb)           { background: var(--paper-dark); border: 1px solid var(--rule); overflow: hidden; aspect-ratio: 4/3; position: relative; }
  :global(.g-thumb img)       { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
  :global(.g-card:hover .g-thumb img) { transform: scale(1.04); }
  :global(.g-type-badge)      {
    position: absolute; bottom: 0.5rem; left: 0.5rem;
    font-family: var(--sans); font-size: 0.58rem; font-weight: 600;
    letter-spacing: 0.1em; text-transform: uppercase;
    background: rgba(28,24,20,0.75); color: var(--paper);
    padding: 2px 7px;
  }
  :global(.g-info)            { }
  :global(.g-title)           { font-family: var(--serif); font-size: 0.9rem; font-weight: 700; color: var(--ink); line-height: 1.3; }
  :global(.g-year)            { font-family: var(--sans); font-size: 0.68rem; color: var(--ink-light); margin-top: 2px; }

  .empty { color: var(--ink-light); font-style: italic; padding: 3rem 0; }

  /* Lightbox */
  .lightbox {
    display:         none;
    position:        fixed;
    inset:           0;
    background:      rgba(28,24,20,0.93);
    z-index:         200;
    align-items:     center;
    justify-content: center;
    padding:         2rem;
    gap:             2rem;
    flex-direction:  column;
  }
  .lightbox.open { display: flex; }

  .lb-close {
    position:   absolute;
    top:        1.25rem;
    right:      1.5rem;
    background: none;
    border:     1px solid rgba(245,240,232,0.3);
    color:      var(--paper);
    font-size:  1.2rem;
    width:      36px; height: 36px;
    cursor:     pointer;
    display:    flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
  }
  .lb-close:hover { background: var(--accent); border-color: var(--accent); }

  .lb-inner {
    display:        flex;
    flex-direction: column;
    align-items:    center;
    gap:            1.25rem;
    max-width:      min(860px, 90vw);
    width:          100%;
  }

  .lb-img {
    max-height: 70vh;
    max-width:  100%;
    object-fit: contain;
    border:     1px solid rgba(255,255,255,0.15);
  }

  .lb-meta { text-align: center; }

  .lb-title {
    font-family:   var(--serif);
    font-size:     1.1rem;
    color:         var(--paper);
    margin-bottom: 0.35rem;
  }
  .lb-caption {
    font-family: var(--sans);
    font-size:   0.75rem;
    color:       var(--rule);
    line-height: 1.5;
    max-width:   600px;
  }
  .lb-tags {
    display:    flex;
    gap:        0.5rem;
    justify-content: center;
    margin-top: 0.5rem;
    flex-wrap:  wrap;
  }
  :global(.lb-tag) {
    font-family:    var(--sans);
    font-size:      0.62rem;
    font-weight:    600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border:         1px solid rgba(200,186,160,0.4);
    color:          var(--rule);
    padding:        2px 8px;
  }

  @media (max-width: 600px) {
    .gallery-grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 1rem; }
    .filter-group { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
  }
</style>

<script>
  // ── Load gallery data ──────────────────────────────────
  type GalleryItem = {
    title:   string;
    era:     string;
    year?:   string;
    image:   string;
    caption?: string;
    subject?: string;
    type:    string;
  };

  let ALL: GalleryItem[] = [];
  let activeEra  = 'All';
  let activeType = 'All';

  async function init() {
    try {
      const res = await fetch('/gallery-data.json');
      if (!res.ok) return;
      ALL = await res.json();
      render();
    } catch (_) {
      document.getElementById('gallery-count')!.textContent = '0 items';
    }
  }

  // ── Render filtered cards ──────────────────────────────
  function render() {
    const grid  = document.getElementById('gallery-grid')!;
    const count = document.getElementById('gallery-count')!;
    const empty = document.getElementById('gallery-empty')!;

    const filtered = ALL.filter(item => {
      const eraMatch  = activeEra  === 'All' || item.era  === activeEra;
      const typeMatch = activeType === 'All' || item.type === activeType;
      return eraMatch && typeMatch;
    });

    count.textContent = `${filtered.length} item${filtered.length !== 1 ? 's' : ''}`;

    // Remove old cards (keep the empty message element)
    grid.querySelectorAll('.g-card').forEach(c => c.remove());

    if (filtered.length === 0) {
      empty.style.display = 'block';
      return;
    }
    empty.style.display = 'none';

    filtered.forEach((item, i) => {
      const card = document.createElement('div');
      card.className   = 'g-card';
      card.dataset.idx = String(ALL.indexOf(item));
      card.innerHTML = `
        <div class="g-thumb">
          <img src="${esc(item.image)}" alt="${esc(item.title)}" loading="lazy" />
          <span class="g-type-badge">${esc(item.type)}</span>
        </div>
        <div class="g-info">
          <div class="g-title">${esc(item.title)}</div>
          ${item.year ? `<div class="g-year">${esc(item.year)}</div>` : ''}
        </div>`;
      card.addEventListener('click', () => openLightbox(ALL.indexOf(item)));
      grid.appendChild(card);
    });
  }

  // ── Filter buttons ─────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.filter-btn:not(.type-btn)').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn:not(.type-btn)').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeEra = btn.dataset.era ?? 'All';
      render();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.type-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.type-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeType = btn.dataset.type ?? 'All';
      render();
    });
  });

  document.getElementById('reset-btn')?.addEventListener('click', () => {
    activeEra  = 'All';
    activeType = 'All';
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach(b => {
      if (b.dataset.era === 'All' || b.dataset.type === 'All') b.classList.add('active');
    });
    render();
  });

  // ── Lightbox ───────────────────────────────────────────
  const lb      = document.getElementById('lightbox')!;
  const lbImg   = document.getElementById('lb-img') as HTMLImageElement;
  const lbTitle = document.getElementById('lb-title')!;
  const lbCap   = document.getElementById('lb-caption')!;
  const lbTags  = document.getElementById('lb-tags')!;

  function openLightbox(idx: number) {
    const item = ALL[idx];
    if (!item) return;
    lbImg.src       = item.image;
    lbImg.alt       = item.title;
    lbTitle.textContent   = item.title;
    lbCap.textContent     = item.caption ?? '';
    lbTags.innerHTML = [
      item.era  ? `<span class="lb-tag">${esc(item.era)}</span>`  : '',
      item.type ? `<span class="lb-tag">${esc(item.type)}</span>` : '',
      item.year ? `<span class="lb-tag">${esc(item.year)}</span>` : '',
    ].join('');
    lb.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lb.classList.remove('open');
    lbImg.src = '';
    document.body.style.overflow = '';
  }

  document.getElementById('lb-close')?.addEventListener('click', closeLightbox);
  lb.addEventListener('click', e => { if (e.target === lb) closeLightbox(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });

  // ── Utility ────────────────────────────────────────────
  function esc(s: string) {
    return s.replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  init();
</script>
