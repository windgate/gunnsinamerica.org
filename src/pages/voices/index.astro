---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('voices'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const TYPE_LABELS: Record<string, string> = {
  memoir:    'Memoir',
  diary:     'Diary',
  fiction:   'Fiction',
  letter:    'Letter',
  essay:     'Essay',
  poem:      'Poem',
  obituary:  'Obituary',
  newspaper: 'Newspaper',
  other:     'Writing',
};
---

<BaseLayout
  title="Voices"
  description="Primary sources in family members' own words — memoirs, diaries, letters, and published writing from the Gunn family across four centuries."
>

  <div class="voices-page">

    <header class="page-header">
      <p class="eyebrow">Gunn Family · Primary Sources</p>
      <h1>Voices</h1>
      <p class="page-desc">
        Memoirs, diaries, letters, and published writing — the Gunn family
        in their own words across four centuries.
      </p>
    </header>

    <div class="entries">
      {entries.length > 0 ? entries.map(entry => (
        <a href={`/voices/${entry.slug}`} class="entry-row">
          <div class="entry-meta">
            <span class="entry-type">{TYPE_LABELS[entry.data.type] ?? entry.data.type}</span>
            <span class="entry-era">{entry.data.era}</span>
            {entry.data.composed && <span class="entry-composed">{entry.data.composed}</span>}
          </div>
          <div class="entry-body">
            <h2 class="entry-title">{entry.data.title}</h2>
            <p class="entry-author">By {entry.data.author}</p>
            {entry.data.excerpt && <p class="entry-excerpt">{entry.data.excerpt}</p>}
          </div>
          <div class="entry-flags">
            {entry.data.audioUrl && <span class="flag flag-audio" title="Audio narration available">♪</span>}
            {entry.data.pdfUrl  && <span class="flag flag-pdf"   title="PDF available">PDF</span>}
            <span class="entry-arrow">→</span>
          </div>
        </a>
      )) : (
        <p class="empty">
          Voices are being prepared. The first entry — Abby Gunn Baker's
          <em>A Little Wayfarer</em> (1903) — is coming soon.
        </p>
      )}
    </div>

  </div>

</BaseLayout>

<style>
  .voices-page {
    max-width: var(--max);
    margin:    0 auto;
    padding:   clamp(2rem, 5vw, 4rem) 2rem;
  }

  .page-header {
    border-bottom:  1px solid var(--rule);
    padding-bottom: 2rem;
    margin-bottom:  3rem;
  }
  .eyebrow {
    font-family:    var(--sans);
    font-size:      0.68rem;
    font-weight:    600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color:          var(--gold);
    margin-bottom:  0.4rem;
  }
  .page-header h1 {
    font-family:   var(--serif);
    font-size:     clamp(2rem, 5vw, 3rem);
    font-weight:   700;
    margin-bottom: 0.5rem;
  }
  .page-desc {
    font-size:   1rem;
    color:       var(--ink-light);
    max-width:   520px;
    line-height: 1.7;
  }

  .entries { display: flex; flex-direction: column; }

  .entry-row {
    display:         grid;
    grid-template-columns: 140px 1fr auto;
    gap:             1.5rem;
    align-items:     start;
    padding:         1.75rem 0;
    border-bottom:   1px solid var(--rule);
    text-decoration: none;
    color:           var(--ink);
    transition:      background 0.12s, padding-left 0.12s;
  }
  .entry-row:hover {
    background:   rgba(200,186,160,0.15);
    padding-left: 0.5rem;
    text-decoration: none;
  }

  .entry-meta {
    display:        flex;
    flex-direction: column;
    gap:            5px;
    padding-top:    3px;
  }
  .entry-type {
    font-family:    var(--sans);
    font-size:      0.62rem;
    font-weight:    600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color:          var(--accent2);
    border:         1px solid var(--accent2);
    padding:        2px 6px;
    width:          fit-content;
  }
  .entry-era {
    font-family:    var(--sans);
    font-size:      0.65rem;
    font-weight:    600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color:          var(--accent);
  }
  .entry-composed {
    font-family: var(--body);
    font-size:   0.78rem;
    font-style:  italic;
    color:       var(--ink-light);
  }

  .entry-title {
    font-family:   var(--serif);
    font-size:     1.15rem;
    font-weight:   700;
    line-height:   1.3;
    margin-bottom: 0.25rem;
  }
  .entry-author {
    font-family:   var(--sans);
    font-size:     0.72rem;
    font-weight:   600;
    letter-spacing: 0.06em;
    color:         var(--ink-light);
    margin-bottom: 0.4rem;
  }
  .entry-excerpt {
    font-size:   0.88rem;
    color:       var(--ink-light);
    line-height: 1.65;
    font-style:  italic;
  }

  .entry-flags {
    display:     flex;
    align-items: center;
    gap:         0.5rem;
    padding-top: 4px;
  }
  .flag {
    font-family:    var(--sans);
    font-size:      0.6rem;
    font-weight:    600;
    letter-spacing: 0.06em;
    color:          var(--ink-light);
    border:         1px solid var(--rule);
    padding:        1px 5px;
  }
  .entry-arrow { color: var(--rule); font-size: 0.9rem; transition: color 0.15s; }
  .entry-row:hover .entry-arrow { color: var(--accent); }

  .empty {
    padding:     3rem 0;
    color:       var(--ink-light);
    font-style:  italic;
    line-height: 1.7;
  }

  @media (max-width: 560px) {
    .entry-row { grid-template-columns: 1fr; gap: 0.5rem; }
    .entry-flags { display: none; }
  }
</style>
